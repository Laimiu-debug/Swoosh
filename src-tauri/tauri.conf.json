{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swoosh",
  "version": "0.1.0",
  "identifier": "dev.laimiu.swoosh",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Swoosh",
      "width": 980,
      "height": 780,
      "minWidth": 620,
      "minHeight": 620,
      "center": true,
      "backgroundColor": "#F7FAF9"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "轻快的局域网文件与文字传输",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false, "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico" } }
  }
}
