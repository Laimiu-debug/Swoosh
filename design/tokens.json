{
  "$description": "Swoosh 设计令牌。项目轻量格式，使用 $type、$value 和引用路径。",
  "$extensions": { "swoosh": { "version": "0.1.0", "updated": "2026-10-06" } },
  "palette": {
    "mint": {
      "50": { "$type": "color", "$value": "#EDF9F4" },
      "100": { "$type": "color", "$value": "#D8F1E7" },
