    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "8px" },
    "control": { "$type": "dimension", "$value": "12px" },
    "card": { "$type": "dimension", "$value": "16px" },
    "panel": { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "1px" }
  },
  "control": {
    "height": { "$type": "dimension", "$value": "44px" },
    "touchTarget": { "$type": "dimension", "$value": "44px" },
    "icon": { "$type": "dimension", "$value": "20px" },
    "iconLarge": { "$type": "dimension", "$value": "24px" }
  },
  "focus": {
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "3px" }
  },
  "layout": {
    "contentMax": { "$type": "dimension", "$value": "1120px" },
    "pageGutter": { "$type": "dimension", "$value": "32px" },
    "mobileGutter": { "$type": "dimension", "$value": "20px" },
    "dialogMax": { "$type": "dimension", "$value": "440px" },
    "breakpointCompact": { "$type": "dimension", "$value": "600px" },
    "breakpointWide": { "$type": "dimension", "$value": "960px" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "normal": { "$type": "duration", "$value": "180ms" },
      "slow": { "$type": "duration", "$value": "240ms" },
      "send": { "$type": "duration", "$value": "360ms" },
      "reduced": { "$type": "duration", "$value": "0ms" }
    },
    "ease": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    }
  },
  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "sticky": { "$type": "number", "$value": 10 },
    "popover": { "$type": "number", "$value": 20 },
    "dialog": { "$type": "number", "$value": 30 },
    "toast": { "$type": "number", "$value": 40 }
  },
  "themes": {
    "light": {
      "color": {
        "background": { "$type": "color", "$value": "{palette.neutral.25}" },
        "surface": { "$type": "color", "$value": "{palette.neutral.0}" },
        "surfaceSubtle": { "$type": "color", "$value": "{palette.neutral.50}" },
        "surfaceHover": { "$type": "color", "$value": "{palette.mint.50}" },
        "textPrimary": { "$type": "color", "$value": "{palette.neutral.900}" },
        "textSecondary": { "$type": "color", "$value": "{palette.neutral.600}" },
        "textMuted": { "$type": "color", "$value": "{palette.neutral.500}" },
        "border": { "$type": "color", "$value": "{palette.neutral.200}" },
        "borderStrong": { "$type": "color", "$value": "{palette.neutral.400}" },
        "primary": { "$type": "color", "$value": "{palette.mint.700}" },
        "primaryHover": { "$type": "color", "$value": "{palette.mint.800}" },
        "primaryPressed": { "$type": "color", "$value": "{palette.mint.900}" },
        "onPrimary": { "$type": "color", "$value": "{palette.neutral.0}" },
        "primarySoft": { "$type": "color", "$value": "{palette.mint.50}" },
        "onPrimarySoft": { "$type": "color", "$value": "{palette.mint.800}" },
        "success": { "$type": "color", "$value": "{palette.status.success}" },
        "successSoft": { "$type": "color", "$value": "{palette.status.successSoft}" },
        "warning": { "$type": "color", "$value": "{palette.status.warning}" },
        "warningSoft": { "$type": "color", "$value": "{palette.status.warningSoft}" },
        "danger": { "$type": "color", "$value": "{palette.status.danger}" },
        "dangerSoft": { "$type": "color", "$value": "{palette.status.dangerSoft}" },
        "info": { "$type": "color", "$value": "{palette.status.info}" },
        "infoSoft": { "$type": "color", "$value": "{palette.status.infoSoft}" },
        "focus": { "$type": "color", "$value": "{palette.mint.700}" },
        "accent": { "$type": "color", "$value": "{palette.apricot.100}" },
        "onAccent": { "$type": "color", "$value": "{palette.apricot.800}" },
        "disabledBackground": { "$type": "color", "$value": "{palette.neutral.100}" },
        "disabledText": { "$type": "color", "$value": "{palette.neutral.500}" },
        "backdrop": { "$type": "color", "$value": "rgba(8, 21, 16, 0.24)" }
      },
      "shadow": {
        "small": { "$type": "shadow", "$value": "0 2px 8px rgba(20, 40, 32, 0.04)" },
        "panel": { "$type": "shadow", "$value": "0 8px 32px rgba(20, 40, 32, 0.06)" },
        "dialog": { "$type": "shadow", "$value": "0 16px 48px rgba(20, 40, 32, 0.14)" }
      }
    },
    "dark": {
      "color": {
        "background": { "$type": "color", "$value": "{palette.neutral.950}" },
        "surface": { "$type": "color", "$value": "{palette.neutral.900}" },
        "surfaceSubtle": { "$type": "color", "$value": "{palette.neutral.850}" },
        "surfaceHover": { "$type": "color", "$value": "{palette.neutral.800}" },
        "textPrimary": { "$type": "color", "$value": "{palette.neutral.50}" },
        "textSecondary": { "$type": "color", "$value": "{palette.neutral.300}" },
        "textMuted": { "$type": "color", "$value": "{palette.neutral.350}" },
        "border": { "$type": "color", "$value": "{palette.neutral.700}" },
        "borderStrong": { "$type": "color", "$value": "{palette.neutral.400}" },
        "primary": { "$type": "color", "$value": "{palette.mint.400}" },
        "primaryHover": { "$type": "color", "$value": "{palette.mint.300}" },
        "primaryPressed": { "$type": "color", "$value": "{palette.mint.200}" },
        "onPrimary": { "$type": "color", "$value": "{palette.neutral.950}" },
        "primarySoft": { "$type": "color", "$value": "#193C31" },
        "onPrimarySoft": { "$type": "color", "$value": "{palette.mint.300}" },
        "success": { "$type": "color", "$value": "#82D9A4" },
        "successSoft": { "$type": "color", "$value": "#19392A" },
        "warning": { "$type": "color", "$value": "#F0C36B" },
        "warningSoft": { "$type": "color", "$value": "#3A2F15" },
        "danger": { "$type": "color", "$value": "#FFABA4" },
        "dangerSoft": { "$type": "color", "$value": "#40251F" },
        "info": { "$type": "color", "$value": "#9DC4FF" },
        "infoSoft": { "$type": "color", "$value": "#1E3045" },
        "focus": { "$type": "color", "$value": "{palette.mint.400}" },
        "accent": { "$type": "color", "$value": "#3C2C20" },
        "onAccent": { "$type": "color", "$value": "{palette.apricot.300}" },
        "disabledBackground": { "$type": "color", "$value": "{palette.neutral.800}" },
        "disabledText": { "$type": "color", "$value": "{palette.neutral.400}" },
        "backdrop": { "$type": "color", "$value": "rgba(0, 0, 0, 0.48)" }
      },
      "shadow": {
        "small": { "$type": "shadow", "$value": "0 2px 8px rgba(0, 0, 0, 0.12)" },
        "panel": { "$type": "shadow", "$value": "0 8px 32px rgba(0, 0, 0, 0.16)" },
        "dialog": { "$type": "shadow", "$value": "0 16px 48px rgba(0, 0, 0, 0.32)" }
      }
    }
  }
}
