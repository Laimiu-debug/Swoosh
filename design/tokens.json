      "300": { "$type": "color", "$value": "#85D9BE" },
      "400": { "$type": "color", "$value": "#6DD6BB" },
      "500": { "$type": "color", "$value": "#31AE8B" },
      "600": { "$type": "color", "$value": "#119175" },
      "700": { "$type": "color", "$value": "#087F6B" },
      "800": { "$type": "color", "$value": "#086653" },
      "900": { "$type": "color", "$value": "#064D40" }
    },
    "neutral": {
      "0": { "$type": "color", "$value": "#FFFFFF" },
      "25": { "$type": "color", "$value": "#F7FAF9" },
      "50": { "$type": "color", "$value": "#F0F5F2" },
      "100": { "$type": "color", "$value": "#E5EEE8" },
      "200": { "$type": "color", "$value": "#D9E5DD" },
