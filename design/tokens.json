      "800": { "$type": "color", "$value": "#233E33" },
      "850": { "$type": "color", "$value": "#1B322A" },
      "900": { "$type": "color", "$value": "#142820" },
      "950": { "$type": "color", "$value": "#10211B" },
      "1000": { "$type": "color", "$value": "#081510" }
    },
    "apricot": {
      "100": { "$type": "color", "$value": "#FFE9D7" },
      "200": { "$type": "color", "$value": "#FFD3AE" },
      "300": { "$type": "color", "$value": "#FFC392" },
      "800": { "$type": "color", "$value": "#96502B" }
    },
    "status": {
      "success": { "$type": "color", "$value": "#147D50" },
      "successSoft": { "$type": "color", "$value": "#EAF8EF" },
      "warning": { "$type": "color", "$value": "#8B5B11" },
      "warningSoft": { "$type": "color", "$value": "#FFF5DC" },
      "danger": { "$type": "color", "$value": "#B6453F" },
