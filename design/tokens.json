      "info": { "$type": "color", "$value": "#316BB0" },
      "infoSoft": { "$type": "color", "$value": "#EEF5FF" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "\"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "\"Cascadia Code\", \"SFMono-Regular\", Consolas, monospace" }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "12px" },
      "label": { "$type": "dimension", "$value": "14px" },
      "body": { "$type": "dimension", "$value": "16px" },
      "subtitle": { "$type": "dimension", "$value": "18px" },
      "title": { "$type": "dimension", "$value": "24px" },
      "hero": { "$type": "dimension", "$value": "32px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "lineHeight": {
      "body": { "$type": "number", "$value": 1.6 },
      "compact": { "$type": "number", "$value": 1.4 },
      "heading": { "$type": "number", "$value": 1.25 }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
